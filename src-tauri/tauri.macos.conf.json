{
  "$schema": "https://schema.tauri.app/config/2",
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Kimi Code",
        "url": "index.html",
        "width": 1040,
        "height": 680,
        "minWidth": 720,
        "minHeight": 520,
        "decorations": true,
        "titleBarStyle": "Overlay",
        "trafficLightPosition": {
          "x": 14,
          "y": 18
        },
        "center": true,
        "visible": false
      }
    ]
  },
  "bundle": {
    "targets": [
      "dmg"
    ],
    "externalBin": [
      "binaries/desktop-runtime"
    ],
    "macOS": {
      "minimumSystemVersion": "12.0",
      "hardenedRuntime": true
    },
    "icon": [
      "icons/icon.png",
      "icons/icon.icns"
    ]
  }
}
